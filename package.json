{
  "name": "curio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "vercel-build": "npm run build",
    "start": "tsx server/index.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test server/learningService.test.ts server/app.test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.2",
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "openai": "^7.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0"
  }
}
