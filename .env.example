PORT=3001

# Optional: without these, Curio uses its local quiz provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Required on Vercel. Added automatically by the Upstash integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sessions expire after seven days by default.
SESSION_TTL_SECONDS=604800
